# Local development settings. Copy to .env (git-ignored) and replace every secret.
# Never put production secrets in this file or in VITE_* variables.
# Full reference: docs/OPERATIONS.md (section "Configuration").

# --- PostgreSQL (infra/compose.yaml) ---
ULYSSE_DB_HOST=127.0.0.1
ULYSSE_DB_PORT=55432
ULYSSE_DB_NAME=ulysse
# Admin credentials are only used by `npm run db:bootstrap` and integration tests.
ULYSSE_DB_ADMIN_USER=postgres
ULYSSE_DB_ADMIN_PASSWORD=change-me-admin-password
ULYSSE_DB_MIGRATOR_PASSWORD=change-me-migrator-password
ULYSSE_DB_APP_PASSWORD=change-me-app-password
ULYSSE_DB_WORKER_PASSWORD=change-me-worker-password

# --- Identity (local Keycloak, infra/keycloak) ---
OIDC_ISSUER=http://localhost:8080/realms/ulysse
OIDC_CLIENT_ID=ulysse-web
# Development-only client secret declared in infra/keycloak/ulysse-realm.json.
OIDC_CLIENT_SECRET=dev-only-ulysse-web-client-secret
# Plain HTTP to the IdP is refused in production.
OIDC_ALLOW_INSECURE_HTTP=true
# Optional: base URL the API uses to reach the IdP when it differs from the public issuer
# (e.g. http://keycloak:8080 inside a container network).
# OIDC_INTERNAL_BASE_URL=

# --- API ---
API_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=change-me-session-secret-at-least-32-characters
COOKIE_SECURE=false
WEB_DIST_DIR=../web/dist
# Bearer token required by /metrics (API and worker); at least 24 characters.
METRICS_TOKEN=change-me-metrics-token-24chars

# --- Worker ---
# Fictional fixture CRM only: never presented as a real integration.
ENABLE_FIXTURE_CONNECTOR=true
WORKER_HTTP_PORT=3001

# --- Optional model-assisted wording (UL-010). Off by default: deterministic wording only. ---
# MODEL_PROVIDER=none | openrouter
MODEL_PROVIDER=none
# OPENROUTER_API_KEY=
# MODEL_ID=
# MODEL_TIMEOUT_MS=15000
# MODEL_MAX_OUTPUT_TOKENS=400
# Monthly budget per company in USD (0 = no model call).
MODEL_TENANT_MONTHLY_BUDGET_USD=0

# --- UL-016 agentic demo. Explicit activation; no paid call by default. ---
ULYSSE_ANALYSIS_MODE=rules
ENABLE_DEMO_SCENARIOS=false
# HERMES_SERVICE_TOKEN=<32+ random characters>
# OPENROUTER_API_KEY=<authorized demo key>
# AGENT_MODEL_ID=openai/gpt-4.1-mini
# AGENT_RUN_BUDGET_USD=0.25
# AGENT_SESSION_BUDGET_USD=2
# AGENT_MONTH_BUDGET_USD=10
# AGENT_SESSION_ID=<stable validation session identifier>
# See docs/DEMO-AGENTIQUE.md for the private Docker overlay and PowerShell commands.
